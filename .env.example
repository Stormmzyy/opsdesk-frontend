# Copy this file to .env (cp .env.example .env) and change values if needed.
#
# Only variables starting with VITE_ are exposed to the app, and Vite copies
# their values INTO the JavaScript the browser downloads. Never put secrets,
# API keys or passwords in this file or in .env.
#
# Vite reads .env only when the dev server starts, so restart `npm run dev`
# after changing it. A variable set in the environment wins over .env.

# Where the app sends its API requests: the real OpsDesk backend
# (opsdesk-backend, run with SPRING_PROFILES_ACTIVE=dev). The backend accepts
# browser requests from one origin, its ALLOWED_ORIGIN setting, which is
# http://localhost:5173 under dev, so run the dev server on that port.
#
# For a production build, this is read when `npm run build` RUNS and written
# into the bundle; changing it on the server afterwards does nothing. Set it
# in the build's environment, e.g.
#   VITE_API_URL=https://api.example.com/api/v1 npm run build
# If it's missing, the build refuses to run (vite.config.ts), rather than
# producing an app that calls /api/v1 on its own origin. A path such as
# /api/v1 is accepted when written out: it's right when the server that
# serves the app forwards /api to the backend.
VITE_API_URL=http://localhost:8080/api/v1

# Set to true to use the in-browser mock API (MSW) instead of the backend,
# for working on the frontend without the backend running. The mock answers
# at /api/v1, so also set VITE_API_URL=/api/v1 when you turn this on.
VITE_USE_MOCK_API=false
